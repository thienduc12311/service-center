{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-simulated-delivery",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd backend && RESEND_API_KEY= EXPO_ACCESS_TOKEN= PORT=4000 npx tsx src/index.ts"],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@service-center/frontend"],
      "port": 5173
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@service-center/admin"],
      "port": 5174
    },
    {
      "name": "website",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4321", "--directory", "website"],
      "port": 4321
    },
    {
      "name": "mobile-metro",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:mobile"],
      "port": 8081
    },
    {
      "name": "mobile-ios",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "npm run build:shared && npm run ios -w @service-center/mobile"],
      "port": 8081
    }
  ]
}
