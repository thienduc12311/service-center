# Local Supabase defaults come from `supabase start` — run it and copy the keys.
NODE_ENV=development
PORT=4000

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Comma separated. Expo dev clients hit the API from a LAN address.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,exp://127.0.0.1:8081

# Allow any *.vercel.app origin. Vercel preview deployments get a fresh hostname
# on every push, so they can't be listed above. Set this to true on the API
# project's Preview environment only — never in production.
CORS_ALLOW_VERCEL_PREVIEWS=false

# Where invite emails should send people.
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# Optional email delivery. Without a key, emails are simulated (logged, reported
# as "Simulated — not sent", never as sent).
RESEND_API_KEY=
MAIL_FROM_ADDRESS=notifications@example.com
MAIL_FROM_NAME=Service Center

# Push notifications (Expo). Leave PUSH_ENABLED=false locally: the backend then
# logs each push instead of calling Expo. EXPO_ACCESS_TOKEN is only needed once
# push security is enabled on the Expo project.
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# Delivery worker. Notifications are queued in the database and delivered right
# after the action that caused them; anything left over (a crash, a provider
# outage, a retry) waits for a worker run: `npm run worker -w @service-center/backend`
# or GET/POST /api/v1/internal/deliveries/run with `Authorization: Bearer $CRON_SECRET`
# (at least 16 characters; Vercel Cron sends it automatically). Leave empty to
# disable the HTTP entry point.
CRON_SECRET=

# F08: stable HMAC key (32+ chars) for emailed response-link tokens; enables
# provider idempotency for retried request/reminder emails. Optional.
# DELIVERY_LINK_SECRET=
