# Local Supabase defaults come from `supabase start` — run it and copy the keys.
NODE_ENV=development
PORT=4000

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Comma separated. Expo dev clients hit the API from a LAN address.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,exp://127.0.0.1:8081

# Where invite emails should send people.
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# Phase 2 OCR. `stub` needs no credentials and returns a fixture, which keeps
# the whole import flow testable before a real provider is wired up.
# `gemini` is the recommended real provider: Google AI Studio issues a key with
# a free tier, which is enough for the 10-imports-per-admin-per-day allowance.
#   stub | gemini | openai | anthropic
OCR_PROVIDER=stub

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# https://platform.openai.com/api-keys (paid — no free tier)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=

# Chord sheet imports allowed per admin per day; resets at midnight in the
# organization's timezone. Set to 0 to turn importing off entirely.
AI_IMPORT_DAILY_LIMIT=10

# Optional email delivery. Without a key, local development uses the console transport.
RESEND_API_KEY=
MAIL_FROM_ADDRESS=notifications@example.com
MAIL_FROM_NAME=Service Center
