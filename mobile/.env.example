# Expo reads EXPO_PUBLIC_* at build time and exposes them on process.env.
# On a physical device, point these at your machine's LAN IP, not localhost.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
EXPO_PUBLIC_API_URL=http://localhost:4000

# Only needed for a real device build (EAS build / `expo prebuild`) to
# enable Universal Links (iOS) / App Links (Android), so the accept-invite
# email link opens this app directly instead of a browser. Leave unset for
# local `expo start` — the servicecenter:// scheme already works without it.
# Must match APP_URL's host (no protocol) on the backend, and the domain
# hosting frontend/public/.well-known/apple-app-site-association +
# assetlinks.json (see that folder's README for what those files need).
WEB_APP_DOMAIN=
